# Copia este archivo como .env y completa los valores.

# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers).
# Las transacciones requieren un replica set: Atlas lo es; un mongod local debe iniciarse con --replSet.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Base de datos (opcional, por defecto gestion_inmobiliaria).
MONGODB_DB=gestion_inmobiliaria

# Secreto para firmar los JWT: una cadena larga y aleatoria.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto

# Origen del frontend permitido por CORS y usado en los enlaces de los correos.
FRONTEND_URL=http://localhost:5173

# Puerto de la API (opcional, por defecto 3000).
PORT=3000

# Solo en Vercel: secreto con que Vercel Cron llama a GET /api/tareas.
# CRON_SECRET=
